appsettings.Local.json
appsettings.*.Local.json
secrets.json
*.pfx
*.snk
.env
.env.*
!.env.example

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Rider / JetBrains
.idea/
*.iml

# Generated files
**/Generated/
StyleCop.Cache

# Benchmark outputs
BenchmarkDotNet.Artifacts/

# Docker volumes for local dev
.volumes/

# EF Core design-time cache
*.DesignerState.xml

# Personal files
docs/
%NUGET_PACKAGES%/
